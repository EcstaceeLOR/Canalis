# Canalis judge/demo defaults
# This file intentionally contains no secrets.

# Solana explorer cluster used for settlement links.
CANALIS_SOLANA_CLUSTER=devnet

# Deterministic is the default judge-safe mode. It never fabricates on-chain
# signatures; live protocol/on-chain evidence must come from real integrations.
CANALIS_DEMO_MODE=deterministic

# Optional live protocol resources. Leave blank for the deterministic demo.
CANALIS_X402_RESOURCE_URL=
CANALIS_MPP_RESOURCE_URL=

# Signers/private keys are injected by the runtime or wallet integration.
# Never place private keys, seed phrases, or wallet secrets in committed files.
