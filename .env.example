# Canalis application configuration
# This file intentionally contains no secrets.

# Durable application storage. Use a pooled Postgres URL in serverless production.
# Example only; do not commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canalis

# Solana explorer cluster used for settlement links.
CANALIS_SOLANA_CLUSTER=devnet

# Deterministic remains a provider mode for safe local/reference execution. It uses
# the same application service, policy engine, repository, and API as live modes.
CANALIS_DEMO_MODE=deterministic

# Optional live protocol resources. Leave blank for deterministic providers.
CANALIS_X402_RESOURCE_URL=
CANALIS_MPP_RESOURCE_URL=

# Signers/private keys are injected by the runtime or wallet integration.
# Never place private keys, seed phrases, or wallet secrets in committed files.
