# Canalis application configuration
# This file intentionally contains no secrets.

# Stable public product URL used for canonical metadata, sitemap, and release links.
# Override only when the production alias/custom domain actually exists.
CANALIS_SITE_URL=https://canalis-sigma.vercel.app

# Optional human-readable release label. Vercel commit metadata is still exposed
# separately by the public health endpoint.
CANALIS_RELEASE_VERSION=

# Durable application storage. Use a pooled Postgres URL in serverless production.
# Example only; do not commit real credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/canalis

# Solana explorer cluster used for settlement links.
CANALIS_SOLANA_CLUSTER=devnet

# Deterministic remains a provider mode for safe local/reference execution. It uses
# the same application service, policy engine, repository, and API as live modes.
CANALIS_DEMO_MODE=deterministic

# Optional live protocol resources. Leave blank for deterministic providers.
CANALIS_X402_RESOURCE_URL=
CANALIS_MPP_RESOURCE_URL=

# Provider API credentials are encrypted at rest with AES-256-GCM. Configure a
# base64-encoded 32-byte key in every environment that saves or reads provider
# credentials. Generate one outside the repository, e.g. `openssl rand -base64 32`.
CANALIS_PROVIDER_SECRET_KEY=

# Developer webhook signing secrets are also AES-256-GCM encrypted at rest. API
# tokens themselves are hash-only and are never recoverable after initial display.
# Use a different base64-encoded 32-byte key from CANALIS_PROVIDER_SECRET_KEY.
CANALIS_DEVELOPER_SECRET_KEY=

# Production abuse/retry controls. Values outside the documented safe bounds are
# clamped by the server. Defaults are appropriate for the product UI.
CANALIS_PUBLIC_AUTH_RATE_LIMIT_PER_MINUTE=20
CANALIS_AUTHENTICATED_RATE_LIMIT_PER_MINUTE=240
CANALIS_IDEMPOTENCY_TTL_SECONDS=86400

# Signers/private keys are injected by the runtime or wallet integration.
# Never place private keys, seed phrases, API tokens, webhook signing secrets,
# signed authorization payloads, or wallet secrets in committed files or logs.
